{
  "openapi": "3.1.0",
  "info": {
    "title": "Tazumo Marketplace API",
    "version": "0.3.0-draft",
    "description": "Contract proposal. The read-only Discovery operations and the Identity operations (/v1/me, merchant staff) have a reference implementation in apps/api (synthetic fixture data, not deployed). All prices are server-calculated. Checkout is disabled in the current clients."
  },
  "servers": [
    {
      "url": "https://api.example.invalid",
      "description": "Placeholder only. No public API is deployed."
    }
  ],
  "tags": [
    {
      "name": "Discovery"
    },
    {
      "name": "Orders"
    },
    {
      "name": "Identity"
    }
  ],
  "paths": {
    "/v1/markets": {
      "get": {
        "tags": [
          "Discovery"
        ],
        "summary": "List supported market configurations",
        "responses": {
          "200": {
            "description": "Supported markets",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Market"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/merchants": {
      "get": {
        "tags": [
          "Discovery"
        ],
        "summary": "Discover merchants by market",
        "parameters": [
          {
            "name": "marketCode",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Market code. Values outside ^[a-z0-9-]{1,64}$ or unknown markets return 400."
          }
        ],
        "responses": {
          "200": {
            "description": "Merchant results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Merchant"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/merchants/{merchantId}/products": {
      "get": {
        "tags": [
          "Discovery"
        ],
        "summary": "List merchant products and availability",
        "parameters": [
          {
            "name": "merchantId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Merchant products",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Product"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/order-quotes": {
      "post": {
        "tags": [
          "Orders"
        ],
        "summary": "Get authoritative, expiring price and availability quote",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuoteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Quote with verified prices, fees and taxes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Quote"
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/orders": {
      "post": {
        "tags": [
          "Orders"
        ],
        "summary": "Create order with idempotent payment orchestration",
        "description": "Do not capture payment or claim fulfillment without persisted provider confirmation and merchant acceptance.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrderRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Persisted order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/orders/{orderId}": {
      "get": {
        "tags": [
          "Orders"
        ],
        "summary": "Get authenticated order snapshot",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/orders/{orderId}/events": {
      "get": {
        "tags": [
          "Orders"
        ],
        "summary": "Get append-only order events in sequence order",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Order events",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OrderEvent"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/me": {
      "get": {
        "tags": [
          "Identity"
        ],
        "summary": "Get the authenticated principal and its role grants",
        "description": "The first authenticated call creates the user record with the customer role. Tazumo stores only the token issuer and subject, no profile data.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authenticated principal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Principal"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token",
            "headers": {
              "WWW-Authenticate": {
                "description": "Bearer challenge (RFC 6750)",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Authentication not configured or identity provider keys unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/merchants/{merchantId}/staff": {
      "get": {
        "tags": [
          "Identity"
        ],
        "summary": "List role grants for a merchant",
        "description": "Allowed for staff of that merchant, support and admin (support and admin reads are audited). Customers get 404 and other staff get 403.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "merchantId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Staff grants",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/StaffMember"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token",
            "headers": {
              "WWW-Authenticate": {
                "description": "Bearer challenge (RFC 6750)",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Authentication not configured or identity provider keys unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Money": {
        "type": "object",
        "required": [
          "currency",
          "minorUnits"
        ],
        "properties": {
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "example": "EUR"
          },
          "minorUnits": {
            "type": "integer",
            "minimum": 0,
            "example": 1290
          }
        },
        "additionalProperties": false
      },
      "ApiError": {
        "type": "object",
        "required": [
          "code",
          "message",
          "requestId"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "Market": {
        "type": "object",
        "required": [
          "code",
          "countryCode",
          "currency",
          "locale"
        ],
        "properties": {
          "code": {
            "type": "string",
            "example": "prague"
          },
          "countryCode": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2,
            "example": "CZ"
          },
          "currency": {
            "type": "string",
            "example": "CZK"
          },
          "locale": {
            "type": "string",
            "example": "cs-CZ"
          }
        }
      },
      "Merchant": {
        "type": "object",
        "required": [
          "id",
          "marketCode",
          "name",
          "categories",
          "acceptingOrders"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,64}$",
            "description": "Stable human-readable identifier, unique among merchants (for example `piazza-local`)"
          },
          "marketCode": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptingOrders": {
            "type": "boolean"
          },
          "deliveryEtaMinutes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "description": "Estimated only, not a promise"
          },
          "synthetic": {
            "type": "boolean",
            "description": "True when the record is synthetic demonstration data, not a real merchant or offer"
          }
        }
      },
      "Product": {
        "type": "object",
        "required": [
          "id",
          "merchantId",
          "name",
          "price",
          "available"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,64}$",
            "description": "Stable human-readable identifier, unique among products (for example the fixture product ID `pizza`)"
          },
          "merchantId": {
            "type": "string",
            "format": "uuid"
          },
          "category": {
            "type": "string",
            "description": "Catalogue category code",
            "example": "food"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price": {
            "$ref": "#/components/schemas/Money"
          },
          "available": {
            "type": "boolean"
          },
          "synthetic": {
            "type": "boolean",
            "description": "True when the record is synthetic demonstration data, not a real merchant or offer"
          }
        }
      },
      "DeliveryAddress": {
        "type": "object",
        "required": [
          "countryCode",
          "postalCode",
          "addressLine1",
          "city"
        ],
        "properties": {
          "countryCode": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2
          },
          "postalCode": {
            "type": "string"
          },
          "addressLine1": {
            "type": "string"
          },
          "addressLine2": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "instructions": {
            "type": "string",
            "maxLength": 500
          }
        },
        "additionalProperties": false
      },
      "OrderItem": {
        "type": "object",
        "required": [
          "productId",
          "quantity"
        ],
        "properties": {
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "additionalProperties": false
      },
      "QuoteRequest": {
        "type": "object",
        "required": [
          "marketCode",
          "merchantId",
          "items",
          "deliveryAddress"
        ],
        "properties": {
          "marketCode": {
            "type": "string"
          },
          "merchantId": {
            "type": "string",
            "format": "uuid"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            }
          },
          "deliveryAddress": {
            "$ref": "#/components/schemas/DeliveryAddress"
          }
        },
        "additionalProperties": false
      },
      "Quote": {
        "type": "object",
        "required": [
          "id",
          "expiresAt",
          "subtotal",
          "deliveryFee",
          "tax",
          "total",
          "itemsAvailable"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "subtotal": {
            "$ref": "#/components/schemas/Money"
          },
          "deliveryFee": {
            "$ref": "#/components/schemas/Money"
          },
          "tax": {
            "$ref": "#/components/schemas/Money"
          },
          "total": {
            "$ref": "#/components/schemas/Money"
          },
          "itemsAvailable": {
            "type": "boolean"
          },
          "unavailableProductIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "CreateOrderRequest": {
        "type": "object",
        "required": [
          "quoteId",
          "paymentMethodToken"
        ],
        "properties": {
          "quoteId": {
            "type": "string",
            "format": "uuid"
          },
          "paymentMethodToken": {
            "type": "string",
            "description": "Opaque provider token, never raw card details"
          }
        },
        "additionalProperties": false
      },
      "Order": {
        "type": "object",
        "required": [
          "id",
          "status",
          "total",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "created",
              "payment_pending",
              "confirmed",
              "preparing",
              "ready_for_pickup",
              "courier_assigned",
              "picked_up",
              "delivered",
              "cancelled",
              "failed"
            ]
          },
          "total": {
            "$ref": "#/components/schemas/Money"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "OrderEvent": {
        "type": "object",
        "required": [
          "id",
          "orderId",
          "sequence",
          "type",
          "occurredAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "orderId": {
            "type": "string",
            "format": "uuid"
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "type": {
            "type": "string"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RoleGrant": {
        "type": "object",
        "required": [
          "role",
          "merchantId"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "customer",
              "merchant_staff",
              "courier",
              "support",
              "admin"
            ]
          },
          "merchantId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Set only for merchant_staff"
          }
        },
        "additionalProperties": false
      },
      "Principal": {
        "type": "object",
        "required": [
          "userId",
          "roles"
        ],
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoleGrant"
            }
          }
        },
        "additionalProperties": false
      },
      "StaffMember": {
        "type": "object",
        "required": [
          "userId",
          "role"
        ],
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "customer",
              "merchant_staff",
              "courier",
              "support",
              "admin"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  }
}
