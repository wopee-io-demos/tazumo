{
  "name": "tazumo",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev:web": "pnpm --filter @tazumo/web dev",
    "dev:mobile": "pnpm --filter @tazumo/mobile start",
    "build": "pnpm --filter @tazumo/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --filter './packages/**' test && pnpm test:contract && node --test apps/mobile/tooling/image-size-v1-compat/test.cjs",
    "test:contract": "node --experimental-strip-types --test tests/contract/*.test.mts",
    "check:sut": "node --experimental-strip-types scripts/check-sut-contract.mjs",
    "test:e2e": "playwright test",
    "bundle:mobile": "pnpm --filter @tazumo/mobile exec expo export --platform ios && pnpm --filter @tazumo/mobile exec expo export --platform android && pnpm --filter @tazumo/mobile run bundle:dev",
    "dev:sut": "pnpm --filter @tazumo/web dev --host 127.0.0.1 --port 4173 --strictPort"
  },
  "devDependencies": {
    "@actions/expressions": "0.3.61",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.56.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "^5.8.3",
    "yaml": "2.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "postcss": "^8.5.18",
      "image-size": "^2.0.3",
      "metro>image-size": "file:./apps/mobile/tooling/image-size-v1-compat",
      "axe-core": "4.14.1"
    }
  }
}
