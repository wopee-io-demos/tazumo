{
  "name": "tazumo",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev:web": "pnpm --filter @tazumo/web dev",
    "dev:mobile": "pnpm --filter @tazumo/mobile start",
    "build": "pnpm --filter @tazumo/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @tazumo/core test && pnpm --filter @tazumo/commerce test && pnpm --filter @tazumo/merchant-ops test && pnpm test:contract",
    "test:contract": "node --experimental-strip-types --test tests/contract/*.test.mts",
    "test:e2e": "playwright test",
    "bundle:mobile": "pnpm --filter @tazumo/mobile exec expo export --platform ios && pnpm --filter @tazumo/mobile exec expo export --platform android"
  },
  "devDependencies": {
    "@actions/expressions": "0.3.61",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.56.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "postcss": "^8.5.18",
      "image-size": "^2.0.3",
      "axe-core": "4.14.1"
    }
  }
}
