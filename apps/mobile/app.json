{
  "expo": {
    "name": "Tazumo",
    "slug": "tazumo",
    "scheme": "tazumo",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.tazumo.marketplace"
    },
    "android": {
      "package": "io.tazumo.marketplace",
      "adaptiveIcon": {
        "backgroundColor": "#FFF8F0"
      }
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
