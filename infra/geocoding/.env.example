# Copy to .env (never commit it) and adjust to the host. Defaults suit a 64 GB / 6-core host.
# Required: compose refuses to start while it is empty.
NOMINATIM_PASSWORD=
NOMINATIM_DATA_DIR=./data
NOMINATIM_BIND=127.0.0.1
NOMINATIM_PORT=8080
NOMINATIM_THREADS=6
NOMINATIM_WORKERS=4
NOMINATIM_SHM_SIZE=8g
NOMINATIM_PG_SHARED_BUFFERS=4GB
NOMINATIM_PG_MAINTENANCE_WORK_MEM=10GB
NOMINATIM_PG_EFFECTIVE_CACHE_SIZE=24GB
